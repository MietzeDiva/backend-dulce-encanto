# Copia este archivo a ".env" (el .env NO se sube a GitHub) y cambia los valores.
MYSQL_ROOT_PASSWORD=cambia_esta_clave_de_la_bd
# Minimo 32 caracteres. Para generar uno: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-largo-de-al-menos-32-caracteres
# Cuentas de demo: admin@ / vendedor@ / cliente@dulceencanto.cl
APP_SEED_ENABLED=true
APP_SEED_ADMIN_PASSWORD=cambia-clave-admin
APP_SEED_VENDEDOR_PASSWORD=cambia-clave-vendedor
APP_SEED_CLIENTE_PASSWORD=cambia-clave-cliente
'@ | Set-Content -Encoding ascii .env.example